# Copy to .env.executor, then replace the approval-secret placeholder.
# Use the same random secret in .env.approval; do not share database URLs there.
SF_PROD_READONLY_URL=postgresql://sf_reader:sf_reader_pass@127.0.0.1:5433/schemaforge_prod
SF_PROD_WRITE_URL=postgresql://sf_executor:sf_executor_pass@127.0.0.1:5433/schemaforge_prod
SF_APPROVAL_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
SF_HTTP_HOST=127.0.0.1
SF_EXECUTOR_PORT=3101
SF_STATEMENT_TIMEOUT_MS=10000
SF_MIGRATION_TIMEOUT_MS=120000
SF_LOCK_TIMEOUT_MS=3000
SF_APPROVAL_TTL_SECONDS=300
SF_TARGET_ID=prod
SF_LEDGER_TABLE=schemaforge_execution_ledger
