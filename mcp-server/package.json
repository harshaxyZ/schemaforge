{
  "name": "schemaforge-mcp-server",
  "version": "2.1.0",
  "description": "Role-separated MCP services for evidence-driven PostgreSQL migration rehearsal and human-gated execution",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "npm run start:core",
    "start:core": "node --env-file-if-exists=../.env.core dist/index.js --role core",
    "start:executor": "node --env-file-if-exists=../.env.executor dist/index.js --role executor",
    "dev:core": "node --env-file-if-exists=../.env.core --import tsx src/index.ts --role core",
    "dev:executor": "node --env-file-if-exists=../.env.executor --import tsx src/index.ts --role executor",
    "approve": "node --env-file-if-exists=../.env.approval dist/cli/approve.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "pg": "8.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "MIT"
}
