# SchemaForge deployment settings. Copy to deploy/.env on the server and fill in every value.
# deploy/.env is git-ignored. Never commit it, paste it into chat, or show it in a demo video.
#
# Generate each secret with:  openssl rand -hex 32
# Hex values are URL-safe, which matters because the passwords are embedded in connection URLs.

# Public hostname for HTTPS. With no domain, use <public-ip-with-dashes>.sslip.io,
# for example 203-0-113-10.sslip.io for 203.0.113.10.
SF_DOMAIN=

# PostgreSQL passwords (internal only; the databases are never published to the internet).
SF_ADMIN_DB_PASSWORD=
SF_READER_DB_PASSWORD=
SF_EXECUTOR_DB_PASSWORD=
SF_SHADOW_DB_PASSWORD=

# Bearer keys that TrueForge sends to each MCP endpoint. Use two different values.
SF_CORE_MCP_API_KEY=
SF_EXECUTOR_MCP_API_KEY=

# Approval signing secret. Put the same value in your local .env.approval.
# The approval CLI runs on the operator's machine, never on the server.
SF_APPROVAL_SECRET=

# Must match SF_TARGET_ID in your local .env.approval.
SF_TARGET_ID=prod

# Host ports for the gateway. Keep 80/443 on a server; change them for a local test.
HTTP_PORT=80
HTTPS_PORT=443
