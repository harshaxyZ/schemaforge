# SchemaForge uses separate least-privilege environments. Do not copy this file to .env.
#
# Local development (one file per process):
#   config/core.env.example     -> .env.core
#   config/executor.env.example -> .env.executor
#   config/approval.env.example -> .env.approval
#
# Server deployment (Docker Compose + HTTPS gateway):
#   deploy/.env.example         -> deploy/.env
#
# Generate one random approval secret and put the same value only in .env.executor
# (or deploy/.env) and .env.approval. Never put database credentials in .env.approval,
# and never put write or signing credentials in .env.core.
