# SchemaForge uses separate least-privilege process environments.
# Do not copy this legacy compatibility file to .env.
#
# Copy these instead:
#   config/core.env.example     -> .env.core
#   config/executor.env.example -> .env.executor
#   config/approval.env.example -> .env.approval
#
# Generate one random approval secret and place the same value only in
# .env.executor and .env.approval. Never place database credentials in
# .env.approval, and never place write/signing credentials in .env.core.
