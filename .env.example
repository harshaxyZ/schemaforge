# =============================================================================
# SchemaForge v2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Database URLs (PostgreSQL connection strings)
# ---------------------------------------------------------------------------

# Read-write connection to the production database (used ONLY after human approval)
PROD_DATABASE_URL=postgresql://sf_admin:sf_admin_pass@localhost:5433/schemaforge_prod

# Read-only connection to the production database (used for schema inspection)
PROD_READONLY_URL=postgresql://sf_reader:sf_reader_pass@localhost:5433/schemaforge_prod

# Read-write connection to the shadow/sandbox database (used for migration rehearsal)
SHADOW_DATABASE_URL=postgresql://sf_shadow:sf_shadow_pass@localhost:5434/schemaforge_shadow

# ---------------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------------

# API key for the LLM provider (e.g. OpenAI, Anthropic, etc.)
LLM_API_KEY=your-llm-api-key-here

# Model identifier (e.g. gpt-4o, claude-sonnet-4-20250514)
LLM_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Security & Agent Settings
# ---------------------------------------------------------------------------

# How long (seconds) a human approval token remains valid before expiring
APPROVAL_TOKEN_EXPIRY_SECONDS=300

# Port on which the MCP server listens
MCP_SERVER_PORT=3100
